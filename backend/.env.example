# Copy this file to backend/.env to configure Booktracker. All values are optional.

# Google Books API key (free: https://console.cloud.google.com/apis/library/books.googleapis.com).
# Without it Google's shared anonymous quota is usually exhausted and the app
# relies on Open Library, which works fine but has fewer Spanish descriptions.
# The key is only used by the backend and is never sent to the browser.
GOOGLE_BOOKS_API_KEY=

# Contact (email or URL) appended to the User-Agent sent to Open Library.
# Identified clients get a higher rate limit. Leave empty to stay anonymous.
BOOKTRACKER_CONTACT=

# Where the SQLite database and the API cache live (default: backend/data).
# BOOKTRACKER_DATA_DIR=

# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0

# ── Modo multiusuario (cuentas de Google / correo con Supabase) ───────────────
# Déjalo comentado para seguir usando la app como un único usuario local.
# BOOKTRACKER_AUTH=supabase
# SUPABASE_URL=https://xoygqiwdvkpysiedeixr.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...          # clave publicable (la misma del frontend)
# DATABASE_URL=postgresql://postgres.xoygqiwdvkpysiedeixr:TU_CONTRASEÑA@aws-0-us-east-2.pooler.supabase.com:5432/postgres
#   ↑ "Session pooler" de Supabase (Connect → Session pooler). La contraseña es SECRETA: solo aquí o en las
#     variables de entorno del servidor, nunca en el frontend ni en el chat.
